# Copy this file to .env and replace the placeholder locally.
# Never put a real API key in this example file or commit .env.
# Required model service settings
LLM_API_KEY=your_api_key_here
LLM_MODEL=your_model_name
LLM_BASE_URL=https://your-provider.example/v1

# Optional settings
# LLM_SUMMARY_MODEL=your_summary_model_name
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
MINI_AGENT_MAX_CONTEXT_CHARS=200000
# MINI_AGENT_SESSION_DIR=~/.mini-coding-agent/sessions
# MINI_AGENT_MEMORY_DIR=~/.mini-coding-agent/memories
