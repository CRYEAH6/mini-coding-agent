# Copy this file to .env and replace the placeholder locally.
# Never put a real API key in this example file or commit .env.
DEEPSEEK_API_KEY=your_api_key_here

# Optional overrides
DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_SUMMARY_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_MAX_CONTEXT_CHARS=200000
# MINI_AGENT_SESSION_DIR=~/.mini-coding-agent/sessions
# MINI_AGENT_MEMORY_DIR=~/.mini-coding-agent/memories
